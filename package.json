{
  "name": "scottystack",
  "version": "0.0.0",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@playwright/test": "^1.62.1",
    "@scottystack/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "markdownlint-cli2": "^0.23.2",
    "railway": "^3.11.0",
    "syncpack": "^14.3.1",
    "turbo": "^2.7.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "~1.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:api": "cd apps/server && bun run build:api",
    "check": "vp check && turbo run test && bun run test:e2e",
    "check:fix": "vp check --fix",
    "dev": "turbo run dev",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt .",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "preinstall": "bunx only-allow bun",
    "prepare": "bun --bun vp config --no-agent",
    "secrets": "BAO_ADDR=https://bao.scottylabs.org bao login -method=oidc",
    "syncpack": "syncpack lint && syncpack format --check",
    "syncpack:fix": "syncpack format && syncpack fix",
    "syncpack:update": "syncpack update",
    "test": "turbo run test",
    "test:e2e": "playwright test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
